# Copie para functions/.env (nunca commite o arquivo real).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:5173

# Opcionais — só preencha se o redirect padrao nao servir.
# GOOGLE_REDIRECT_URI=https://us-central1-borderless-e4a6a.cloudfunctions.net/googleCalendarOAuthCallback
# FUNCTIONS_REGION=us-central1

# Assistente de IA (ajuda, import de programação, rascunhos).
# Sem chave, as callables usam modo mock (respostas fixas) para desenvolver a UI.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
