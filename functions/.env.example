# Copie para functions/.env (nunca commite o arquivo real).
#   cp functions/.env.example functions/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origem do front em produção (sem barra no final).
# Preferir HTTPS se o cPanel tiver SSL.
APP_ORIGIN=https://app.promoverexperience.com.br
# Local: APP_ORIGIN=http://localhost:5173

# Opcionais — só preencha se o redirect padrao nao servir.
# GOOGLE_REDIRECT_URI=https://us-central1-borderless-e4a6a.cloudfunctions.net/googleCalendarOAuthCallback
# FUNCTIONS_REGION=us-central1

# ---------------------------------------------------------------------------
# Assistente de IA (chat de ajuda, import de programação, rascunhos)
# ---------------------------------------------------------------------------
# 1. Crie uma chave em https://console.anthropic.com/settings/keys
# 2. Cole abaixo (começa com sk-ant-...)
# 3. Faça deploy: npm --prefix functions run deploy
#
# Sem ANTHROPIC_API_KEY o chat usa modo mock (respostas fixas) para desenvolver a UI.

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Modelo Claude (ajuste se quiser mais barato/rápido):
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Só altere se usar proxy ou endpoint compatível com a API Anthropic:
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# ---------------------------------------------------------------------------
# Confirmação de cadastro do portal (DIA 3 CRM) — SMS / WhatsApp via Twilio
# ---------------------------------------------------------------------------
# Sem estas variáveis a Function `onVisitGuestLinkWritten` grava
# status `skipped_no_provider` e não quebra o fluxo do portal.
#
# 1. Crie conta em https://www.twilio.com
# 2. Copie Account SID e Auth Token
# 3. TWILIO_FROM = número SMS no formato +5511...
#    OU TWILIO_WHATSAPP_FROM = whatsapp:+14155238886 (sandbox) / número aprovado
# 4. Deploy: npm --prefix functions run deploy
# 5. Callables de teste (admin): getTwilioStatus, sendTwilioTestMessage
#
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
