# Copie para functions/.env (nunca commite o arquivo real).
#   cp functions/.env.example functions/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origem do front em produção (sem barra no final).
# Preferir HTTPS se o cPanel tiver SSL.
APP_ORIGIN=https://app.promoverexperience.com.br
# Local: APP_ORIGIN=http://localhost:5173

# Opcionais — só preencha se o redirect padrao nao servir.
# GOOGLE_REDIRECT_URI=https://us-central1-borderless-e4a6a.cloudfunctions.net/googleCalendarOAuthCallback
# FUNCTIONS_REGION=us-central1

# ---------------------------------------------------------------------------
# Assistente de IA (chat de ajuda, import de programação, rascunhos)
# ---------------------------------------------------------------------------
# 1. Crie uma chave em https://console.anthropic.com/settings/keys
# 2. Cole abaixo (começa com sk-ant-...)
# 3. Faça deploy das functions de IA (o CLI lê functions/.env e injeta as vars):
#      node scripts/deploy-ai-functions.mjs
#    Ou: firebase deploy --only functions:askHelpAssistant,functions:getAiStatus,...
#
# Sem ANTHROPIC_API_KEY o chat usa modo mock (respostas fixas) para desenvolver a UI.

AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Modelo Claude (ajuste se quiser mais barato/rápido):
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Só altere se usar proxy ou endpoint compatível com a API Anthropic:
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages

# ---------------------------------------------------------------------------
# Confirmação de cadastro do portal (DIA 3 CRM) — SMS / WhatsApp via Twilio
# ---------------------------------------------------------------------------
# Sem estas variáveis a Function `onVisitGuestLinkWritten` grava
# status `skipped_no_provider` e não quebra o fluxo do portal.
#
# 1. Crie conta em https://www.twilio.com
# 2. Copie Account SID e Auth Token
# 3. TWILIO_FROM = número SMS no formato +5511...
#    OU TWILIO_WHATSAPP_FROM = whatsapp:+14155238886 (sandbox) / número aprovado
# 4. Deploy: npm --prefix functions run deploy
# 5. Callables de teste (admin): getTwilioStatus, sendTwilioTestMessage
#
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — convite de cliente do evento
# ---------------------------------------------------------------------------
# Sem estas variáveis o envio grava whatsappSendStatus=skipped_no_provider
# e o convite (e-mail) continua funcionando.
#
# Os 6 pontos (cole no functions/.env e faça deploy):
#   1. META_WA_PHONE_NUMBER_ID
#   2. META_WA_BUSINESS_ACCOUNT_ID
#   3. META_WA_ACCESS_TOKEN          (token permanente / System User)
#   4. META_WA_APP_ID
#   5. META_WA_APP_SECRET
#   6. META_WA_VERIFY_TOKEN          (string que você cola no webhook da Meta)
#
# Webhook (Meta Developers → WhatsApp → Configuration):
#   Callback URL: https://us-central1-<PROJECT>.cloudfunctions.net/whatsappWebhook
#   Verify token: o mesmo valor de META_WA_VERIFY_TOKEN
#   Campos: messages
#
# Template sugerido (Business Manager → Message templates):
#   Nome: convite_evento_cliente | Idioma: pt_BR
#   Corpo com {{1}} = título do evento
#   Quick replies: Aceitar (payload ACCEPT_INVITE) / Recusar (payload DECLINE_INVITE)
#
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
# META_WA_API_VERSION=v21.0
# META_WA_INVITE_TEMPLATE_NAME=convite_evento_cliente
# META_WA_INVITE_TEMPLATE_LANG=pt_BR

# ---------------------------------------------------------------------------
# E-mails transacionais e notificações via Resend (https://resend.com)
# Domínio verificado: app.promoverexperience.com.br.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=convites@app.promoverexperience.com.br
