rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isPlatformAdmin() {
      return isAdmin()
        || (isSignedIn() && request.auth.token.platformAdmin == true);
    }

    function userOrgId() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.orgId;
    }

    function canAccessOrg(orgId) {
      return isPlatformAdmin() || (isSignedIn() && userOrgId() == orgId);
    }

    function visitDoc(visitId) {
      return firestore.get(/databases/(default)/documents/visits/$(visitId));
    }

    function visitData(visitId) {
      return visitDoc(visitId).data;
    }

    function memberIds(field) {
      return field is list ? field : [];
    }

    function canReadVisit(visitId) {
      let visit = visitData(visitId);
      return canAccessOrg(visit.orgId);
    }

    function canWriteVisit(visitId) {
      let visit = visitData(visitId);
      return canAccessOrg(visit.orgId);
    }

    function isImage() {
      return request.resource.contentType.matches('image/jpeg|image/png|image/webp|image/gif');
    }

    match /visits/{visitId}/{allPaths=**} {
      allow read: if isSignedIn() && canReadVisit(visitId);

      allow write: if isSignedIn()
        && canWriteVisit(visitId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*');

      allow delete: if isSignedIn() && canWriteVisit(visitId);
    }

    // Fotos de perfil: cada usuário gerencia a própria pasta.
    match /profiles/{userId}/{fileName} {
      allow read: if isSignedIn();

      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && isImage();

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
