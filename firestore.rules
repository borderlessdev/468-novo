rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function visitData(visitId) {
      return get(/databases/$(database)/documents/visits/$(visitId)).data;
    }

    function memberIds(field) {
      return field is list ? field : [];
    }

    function canReadVisit(visitId) {
      let visit = visitData(visitId);
      return isAdmin()
        || visit.ownerId == request.auth.uid
        || request.auth.uid in memberIds(visit.teamMemberIds)
        || request.auth.uid in memberIds(visit.clientUserIds);
    }

    function canWriteVisit(visitId) {
      let visit = visitData(visitId);
      return isAdmin()
        || visit.ownerId == request.auth.uid
        || request.auth.uid in memberIds(visit.teamMemberIds);
    }

    function ownsOrAdmin() {
      return isAdmin() || resource.data.ownerId == request.auth.uid;
    }

    function creatingOwnDoc() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function unchangedOwnerId() {
      return !('ownerId' in request.resource.data)
        || request.resource.data.ownerId == resource.data.ownerId;
    }

    function validVisitStatus(status) {
      return status in ['planejamento', 'em_andamento', 'concluida', 'cancelada'];
    }

    function validTaskStatus(status) {
      return status in ['backlog', 'in_progress', 'completed'];
    }

    function isSoftDeleteUpdate() {
      return resource.data.isDeleted != true
        && request.resource.data.isDeleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp;
    }

    function isRestoreUpdate() {
      return resource.data.isDeleted == true
        && request.resource.data.isDeleted == false;
    }

    function canTrashUpdate() {
      return isSoftDeleteUpdate() || isRestoreUpdate();
    }

    function canReadChild() {
      return canReadVisit(resource.data.visitId);
    }

    function canWriteChild() {
      return isAdmin()
        || resource.data.ownerId == request.auth.uid
        || canWriteVisit(resource.data.visitId);
    }

    function canCreateChild() {
      return creatingOwnDoc() && canWriteVisit(request.resource.data.visitId);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role in ['user', 'team', 'client'];

      allow update: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
          )
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if isAdmin()
        || resource.data.ownerId == request.auth.uid
        || request.auth.uid in resource.data.teamMemberIds
        || request.auth.uid in resource.data.clientUserIds;

      allow create: if creatingOwnDoc()
        && request.resource.data.title is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && validVisitStatus(request.resource.data.status);

      allow update: if isAdmin()
        || (resource.data.ownerId == request.auth.uid && unchangedOwnerId() && (
          resource.data.isDeleted != true || isRestoreUpdate()
        ))
        || (request.auth.uid in resource.data.teamMemberIds && unchangedOwnerId() && (
          resource.data.isDeleted != true || isRestoreUpdate()
        ))
        || (resource.data.ownerId == request.auth.uid && canTrashUpdate())
        || (request.auth.uid in resource.data.teamMemberIds && canTrashUpdate());

      allow delete: if isAdmin() || resource.data.ownerId == request.auth.uid;
    }

    // get: autenticado (IDs vêm de visitVisitors já protegido).
    // list: só dono/admin (CRM). Trade-off MVP para equipe/cliente no detalhe.
    match /visitors/{visitorId} {
      allow get: if isSignedIn();
      allow list: if ownsOrAdmin();
      allow create: if creatingOwnDoc()
        && request.resource.data.name is string
        && request.resource.data.document is string;
      allow update: if (ownsOrAdmin() && unchangedOwnerId() && (
          resource.data.isDeleted != true || isRestoreUpdate()
        ))
        || (ownsOrAdmin() && canTrashUpdate());
      allow delete: if ownsOrAdmin();
    }

    match /visitVisitors/{id} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.visitorId is string;
      allow update: if false;
      allow delete: if canWriteChild();
    }

    match /activities/{activityId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.title is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string;
      allow update: if (canWriteChild() && unchangedOwnerId() && (
          resource.data.isDeleted != true || isRestoreUpdate()
        ))
        || (canWriteChild() && canTrashUpdate());
      allow delete: if canWriteChild();
    }

    match /tasks/{taskId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.title is string
        && validTaskStatus(request.resource.data.status)
        && request.resource.data.order is number;
      allow update: if (canWriteChild() && unchangedOwnerId() && (
          resource.data.isDeleted != true || isRestoreUpdate()
        ))
        || (canWriteChild() && canTrashUpdate());
      allow delete: if canWriteChild();
    }

    match /financeItems/{itemId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.serviceName is string
        && request.resource.data.nfReceived is bool;
      allow update: if (canWriteChild() && unchangedOwnerId() && (
          resource.data.isDeleted != true || isRestoreUpdate()
        ))
        || (canWriteChild() && canTrashUpdate());
      allow delete: if canWriteChild();
    }

    match /documents/{docId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.name is string
        && request.resource.data.storagePath is string;
      allow update: if canWriteChild() && canTrashUpdate();
      allow delete: if canWriteChild();
    }

    // Firebase Extension "Trigger Email" — fila de envio (SMTP/SendGrid/etc.)
    match /mail/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.to is list
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string;
      allow read, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.read == false
        && (
          !('visitId' in request.resource.data)
          || request.resource.data.visitId == null
          || canReadVisit(request.resource.data.visitId)
        );

      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.read == true;

      allow delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.action is string;
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.actorId == request.auth.uid
        || (resource.data.visitId is string && canReadVisit(resource.data.visitId))
      );
      allow update, delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if resource.data.status == 'pending'
        || (isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin()));
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.token is string
        && request.resource.data.role in ['team', 'client']
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'accepted')
          || resource.data.createdBy == request.auth.uid
          || isAdmin()
        );
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /emailLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.to is list;
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
