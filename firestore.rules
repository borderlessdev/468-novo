rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isPlatformAdmin() {
      return isAdmin()
        || (isSignedIn() && request.auth.token.platformAdmin == true);
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userOrgId() {
      return userProfile().orgId;
    }

    function canAccessOrg(orgId) {
      return isPlatformAdmin() || (isSignedIn() && userOrgId() == orgId);
    }

    function visitData(visitId) {
      return get(/databases/$(database)/documents/visits/$(visitId)).data;
    }

    function memberIds(field) {
      return field is list ? field : [];
    }

    function canReadVisit(visitId) {
      let visit = visitData(visitId);
      return canAccessOrg(visit.orgId);
    }

    function canWriteVisit(visitId) {
      let visit = visitData(visitId);
      return canAccessOrg(visit.orgId) && !isClientUser();
    }

    function ownsOrAdmin() {
      return isPlatformAdmin() || (resource.data.orgId is string && canAccessOrg(resource.data.orgId));
    }

    function creatingOwnDoc() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    function unchangedOwnerId() {
      return !('ownerId' in request.resource.data)
        || request.resource.data.ownerId == resource.data.ownerId;
    }

    function validVisitStatus(status) {
      return status in ['planejamento', 'em_andamento', 'concluida', 'cancelada'];
    }

    function validTaskStatus(status) {
      return status in ['backlog', 'in_progress', 'completed'];
    }

    function signedInRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isClientUser() {
      return isSignedIn() && signedInRole() == 'client';
    }

    function isCurrentlyDeleted() {
      return 'isDeleted' in resource.data && resource.data.isDeleted == true;
    }

    function isSoftDeleteUpdate() {
      return !isCurrentlyDeleted()
        && request.resource.data.isDeleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp;
    }

    function isRestoreUpdate() {
      return isCurrentlyDeleted()
        && request.resource.data.isDeleted == false;
    }

    function canTrashUpdate() {
      return isSoftDeleteUpdate() || isRestoreUpdate();
    }

    function canReadChild() {
      return canReadVisit(resource.data.visitId);
    }

    function canWriteChild() {
      return canWriteVisit(resource.data.visitId);
    }

    function canCreateChild() {
      return creatingOwnDoc() && canWriteVisit(request.resource.data.visitId);
    }

    /** Autoriza a avaliação pública provando a posse de um link válido. */
    function guestLinkGrantsFeedback(linkId, visitId, token) {
      let link = get(/databases/$(database)/documents/visitGuestLinks/$(linkId)).data;
      return link.revoked != true
        && link.visitId == visitId
        && link.token == token
        && 'expiresAtTs' in link
        && request.time < link.expiresAtTs;
    }

    match /organizations/{orgId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin()
        && request.resource.data.name is string
        && request.resource.data.maxUsers is number
        && request.resource.data.status in ['active', 'suspended'];
      allow update, delete: if isPlatformAdmin();
    }

    match /organizationMembers/{memberId} {
      allow get: if isSignedIn()
        && (isPlatformAdmin() || resource.data.uid == request.auth.uid || canAccessOrg(resource.data.orgId));
      allow list: if isSignedIn()
        && (
          isPlatformAdmin()
          || resource.data.uid == request.auth.uid
          || (resource.data.orgId is string && canAccessOrg(resource.data.orgId))
        );
      allow create: if isSignedIn()
        && request.resource.data.orgId is string
        && request.resource.data.uid is string
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.orgRole in ['org_admin', 'user', 'team', 'client']
        && (isPlatformAdmin() || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isPlatformAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      // Conta própria OU platform admin criando perfil do admin da empresa.
      allow create: if isSignedIn()
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role in ['user', 'team', 'client']
        && (!('orgId' in request.resource.data) || request.resource.data.orgId is string)
        && (
          request.auth.uid == userId
          || (
            isPlatformAdmin()
            && request.resource.data.orgId is string
          )
        );

      allow update: if isSignedIn()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
          )
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if canAccessOrg(resource.data.orgId);

      allow create: if creatingOwnDoc()
        && request.resource.data.orgId is string
        && canAccessOrg(request.resource.data.orgId)
        && !isClientUser()
        && request.resource.data.title is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && validVisitStatus(request.resource.data.status);

      allow update: if canAccessOrg(resource.data.orgId)
        && !isClientUser()
        && unchangedOwnerId()
        && (
          !isCurrentlyDeleted() || isRestoreUpdate() || canTrashUpdate()
        );

      allow delete: if canAccessOrg(resource.data.orgId) && !isClientUser();
    }

    // get: autenticado (IDs vêm de visitVisitors já protegido).
    // list: só dono/admin (CRM). Trade-off MVP para equipe/cliente no detalhe.
    match /visitors/{visitorId} {
      allow get: if isSignedIn() && canAccessOrg(resource.data.orgId);
      allow list: if ownsOrAdmin();
      allow create: if creatingOwnDoc()
        && request.resource.data.orgId is string
        && canAccessOrg(request.resource.data.orgId)
        && !isClientUser()
        && request.resource.data.name is string
        && request.resource.data.document is string;
      allow update: if (ownsOrAdmin() && unchangedOwnerId() && (
          !isCurrentlyDeleted() || isRestoreUpdate()
        ))
        || (ownsOrAdmin() && canTrashUpdate());
      allow delete: if ownsOrAdmin();
    }

    match /visitVisitors/{id} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.visitorId is string;
      allow update: if false;
      allow delete: if canWriteChild();
    }

    match /activities/{activityId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.title is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string;
      allow update: if (canWriteChild() && unchangedOwnerId() && (
          !isCurrentlyDeleted() || isRestoreUpdate()
        ))
        || (canWriteChild() && canTrashUpdate());
      allow delete: if canWriteChild();
    }

    match /tasks/{taskId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.title is string
        && validTaskStatus(request.resource.data.status)
        && request.resource.data.order is number;
      allow update: if (canWriteChild() && unchangedOwnerId() && (
          !isCurrentlyDeleted() || isRestoreUpdate()
        ))
        || (canWriteChild() && canTrashUpdate());
      allow delete: if canWriteChild();
    }

    match /financeItems/{itemId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.serviceName is string
        && request.resource.data.nfReceived is bool;
      allow update: if (canWriteChild() && unchangedOwnerId() && (
          !isCurrentlyDeleted() || isRestoreUpdate()
        ))
        || (canWriteChild() && canTrashUpdate());
      allow delete: if canWriteChild();
    }

    match /documents/{docId} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.name is string
        && request.resource.data.storagePath is string;
      allow update: if canWriteChild() && canTrashUpdate();
      allow delete: if canWriteChild();
    }

    match /documentPlaceholders/{id} {
      allow read: if canReadChild();
      allow create: if canCreateChild()
        && request.resource.data.visitId is string
        && request.resource.data.title is string
        && request.resource.data.category is string;
      allow update: if canWriteChild() && unchangedOwnerId();
      allow delete: if canWriteChild();
    }

    // Firebase Extension "Trigger Email" — fila de envio (SMTP/SendGrid/etc.)
    match /mail/{mailId} {
      allow create: if isSignedIn()
        && request.resource.data.to is list
        && request.resource.data.message.subject is string
        && request.resource.data.message.text is string;
      allow read, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.read == false
        && (
          !('visitId' in request.resource.data)
          || request.resource.data.visitId == null
          || canReadVisit(request.resource.data.visitId)
        );

      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.read == true;

      allow delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.action is string;
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.actorId == request.auth.uid
        || (resource.data.visitId is string && canReadVisit(resource.data.visitId))
      );
      allow update, delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if resource.data.status == 'pending'
        || (isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin()));
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.token is string
        && request.resource.data.role in ['team', 'client', 'user', 'org_admin']
        && request.resource.data.status == 'pending'
        && request.resource.data.orgId is string;
      allow update: if isSignedIn()
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'accepted')
          || resource.data.createdBy == request.auth.uid
          || isAdmin()
        );
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Portal do visitante: o ID do documento é o token secreto do link.
    // Público pode fazer `get` (nunca `list`) e só alterar confirmação/rascunho.
    match /visitGuestLinks/{linkId} {
      allow get: if (resource.data.revoked != true)
        || (isSignedIn() && canReadVisit(resource.data.visitId));

      allow list: if isSignedIn() && (
        isAdmin()
        || resource.data.ownerId == request.auth.uid
        || canReadVisit(resource.data.visitId)
      );

      allow create: if creatingOwnDoc()
        && canWriteVisit(request.resource.data.visitId)
        && request.resource.data.token is string
        && request.resource.data.visitId is string
        && request.resource.data.visitorId is string
        && request.resource.data.expiresAtTs is timestamp
        && request.resource.data.revoked == false
        && request.resource.data.confirmationStatus == 'pending';

      allow update: if
        // Rota pública (sem login): apenas confirmação e rascunho do visitante.
        (
          resource.data.revoked != true
          && 'expiresAtTs' in resource.data
          && request.time < resource.data.expiresAtTs
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['confirmationStatus', 'visitorDraft', 'updatedAt'])
          && request.resource.data.confirmationStatus in ['pending', 'confirmed', 'declined']
          && (
            request.resource.data.visitorDraft == null
            || request.resource.data.visitorDraft is map
          )
        )
        // Operador: revogar, atualizar snapshot, marcar rascunho como aplicado.
        || (
          isSignedIn()
          && canWriteVisit(resource.data.visitId)
          && unchangedOwnerId()
          && request.resource.data.token == resource.data.token
          && request.resource.data.visitId == resource.data.visitId
          && request.resource.data.visitorId == resource.data.visitorId
        );

      allow delete: if isSignedIn() && canWriteVisit(resource.data.visitId);
    }

    // Avaliação enviada pelo portal. ID do documento = ID do link (1 por link).
    match /visitFeedbacks/{feedbackId} {
      allow get, list: if isSignedIn() && canReadVisit(resource.data.visitId);

      allow create: if request.resource.data.keys()
          .hasOnly(['visitId', 'guestLinkId', 'visitorId', 'rating', 'comment', 'token', 'submittedAt'])
        && request.resource.data.keys()
          .hasAll(['visitId', 'guestLinkId', 'rating', 'token', 'submittedAt'])
        && request.resource.data.guestLinkId == feedbackId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.submittedAt is string
        && guestLinkGrantsFeedback(
          request.resource.data.guestLinkId,
          request.resource.data.visitId,
          request.resource.data.token
        );

      allow update, delete: if false;
    }

    match /playbooks/{playbookId} {
      allow read: if ownsOrAdmin();

      allow create: if creatingOwnDoc()
        && !isClientUser()
        && request.resource.data.name is string
        && request.resource.data.visitType is string
        && request.resource.data.items is list;

      allow update: if ownsOrAdmin()
        && !isClientUser()
        && unchangedOwnerId()
        && request.resource.data.name is string
        && request.resource.data.visitType is string
        && request.resource.data.items is list;

      allow delete: if ownsOrAdmin() && !isClientUser();
    }

    match /emailLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.to is list;
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow update, delete: if false;
    }

    // Status "público" da conexão de calendário: só o dono lê e este doc NUNCA
    // guarda refreshToken. As Functions escrevem aqui via Admin SDK.
    match /calendarConnections/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.ownerId == uid
        && !('refreshToken' in request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Tokens e state do OAuth: exclusivos do Admin SDK (Functions).
    match /calendarSecrets/{uid} {
      allow read, write: if false;
    }

    match /calendarOAuthStates/{state} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
